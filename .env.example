# App
APP_NAME=NovaTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=newsplatform
DB_USERNAME=newsuser
DB_PASSWORD=newspassword

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_ARTICLES=articles

# IA — Google Gemini (principal, mais barato)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# IA — OpenAI (alternativa)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# IA — Limites
AI_MAX_ARTICLES_PER_DAY=3
AI_ESTIMATED_COST_LIMIT_USD=1.00

# NewsAPI
NEWSAPI_KEY=your_newsapi_key_here
NEWSAPI_LANGUAGE=pt

# Queue
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=300

# Frontend
FRONTEND_URL=http://localhost:3000
